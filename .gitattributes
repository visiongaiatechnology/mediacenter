# Auto detect text files and perform LF normalization
* text=auto

# Source code files
*.go text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.php text eol=lf
*.sh text eol=lf
*.md text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.ogg binary
*.wav binary
